{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "de.ozerov.fully",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Fully Kiosk Browser"
  },
  "description": {
    "en": "Control your Fully Kiosk Browser running on Android"
  },
  "category": [
    "tools"
  ],
  "support": "mailto:emile@athom.nl",
  "brandColor": "#2A01E9",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Emile Nijssen",
    "email": "emile@athom.nl"
  },
  "flow": {
    "actions": [
      {
        "id": "cmd_loadStartUrl",
        "title": {
          "en": "Load Start URL"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=fully-kiosk-browser"
          }
        ]
      },
      {
        "id": "cmd_loadUrl",
        "title": {
          "en": "Load URL"
        },
        "titleFormatted": {
          "en": "Load [[url]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=fully-kiosk-browser"
          },
          {
            "name": "url",
            "type": "text",
            "title": {
              "en": "URL"
            },
            "placeholder": {
              "en": "Enter URL"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Fully Kiosk Browser"
      },
      "class": "other",
      "capabilities": [
        "onoff"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/fully-kiosk-browser/assets/images/small.png",
        "large": "/drivers/fully-kiosk-browser/assets/images/large.png",
        "xlarge": "/drivers/fully-kiosk-browser/assets/images/xlarge.png"
      },
      "discovery": "fully",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "enter_password"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "enter_password"
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password"
          }
        }
      ],
      "id": "fully-kiosk-browser"
    }
  ],
  "discovery": {
    "fully": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "fully",
        "protocol": "tcp"
      },
      "id": "{{name}}"
    }
  }
}